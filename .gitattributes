# Fins de ligne normalisées en LF dans le dépôt et la copie de travail.
* text=auto eol=lf

# Scripts Windows : CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.nsh  text eol=crlf

# Binaires.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.icns  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.exe   binary
*.dll   binary
*.dmg   binary
*.zip   binary
*.node  binary
*.asar  binary
